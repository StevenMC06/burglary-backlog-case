'use strict';
const SOURCE={id:'SYN-CAM-01',caseId:'SYN-001',durationSeconds:60,version:'synthetic-scene-v1',preservation:'Original generated scene and complete 0–60s timeline retained; no frames deleted.'};
const FIXTURE={model:'fixture-event-index-v1',dataset:'synthetic-test-v1',liveInference:false};
const TRUTH=[{id:'GT-1',time:15,label:'Person-shaped figure enters side gate',kind:'relevant'},{id:'GT-2',time:35,label:'Parcel moved from porch',kind:'relevant'},{id:'GT-3',time:49,label:'Curtain moves in window',kind:'irrelevant'}];
const INITIAL=[{id:'SUG-1',time:15,label:'Possible entry at side gate',confidence:.82,origin:'precomputed-model-fixture',truthId:'GT-1'},{id:'SUG-2',time:49,label:'Possible movement near entrance',confidence:.76,origin:'precomputed-model-fixture',truthId:'GT-3'}];
function computeMetrics(events){const approved=events.filter(e=>e.decision==='accepted');const relevantIds=new Set(TRUTH.filter(t=>t.kind==='relevant').map(t=>t.id));const correct=new Set(approved.filter(e=>relevantIds.has(e.truthId)).map(e=>e.truthId));const bad=approved.filter(e=>!relevantIds.has(e.truthId)).length;return{truePositives:correct.size,falsePositives:bad,falseNegatives:relevantIds.size-correct.size,recall:correct.size/relevantIds.size,precision:approved.length?correct.size/(correct.size+bad):null};}
function packet(events,audit,elapsed){return{disclosure:'Synthetic interactive prototype. Precomputed suggestions; no live model inference. No real evidence or suspect identification.',source:SOURCE,fixture:FIXTURE,acceptedEvents:events.filter(e=>e.decision==='accepted').map(({truthId,...e})=>({...e,sourceId:SOURCE.id})),reviewAudit:audit,reviewElapsedSeconds:elapsed,groundTruthMetrics:computeMetrics(events),limitations:['Synthetic labels do not measure real-world accuracy.','Session timing has no controlled baseline.','No CJIS compliance or clearance impact demonstrated.']};}
if(typeof module!=='undefined')module.exports={computeMetrics,packet,INITIAL,TRUTH};
if(typeof document!=='undefined'){
let events,audit,t=0,playing=false,last=0,start=Date.now(),revealed=false;
const $=id=>document.getElementById(id),ctx=$('scene').getContext('2d');
const stamp=s=>'00:'+String(Math.floor(s)).padStart(2,'0');
function log(action,event){audit.push({at:new Date().toISOString(),reviewer:'demo-human-reviewer',action,eventId:event?.id??null,sourceId:SOURCE.id,sourceTimestamp:event?.time??Number(t.toFixed(1))});renderAudit();}
function renderAudit(){$('audit').replaceChildren();for(const a of [...audit].reverse()){let tr=document.createElement('tr');for(const v of [new Date(a.at).toLocaleTimeString(),a.action,(a.eventId??'SOURCE')+' • '+stamp(a.sourceTimestamp)]){let td=document.createElement('td');td.textContent=v;tr.append(td)}$('audit').append(tr)}}
function jump(e){t=Math.max(0,e.time-3);playing=false;log('view-source-context',e);draw();}
function decide(e,d){e.decision=d;log(d,e);render();}
function render(){$('events').replaceChildren();for(const e of events){let box=document.createElement('div');box.className='event';let title=document.createElement('b');title.textContent=stamp(e.time)+' — '+e.label;box.append(title);let meta=document.createElement('p');meta.className='small';meta.textContent=e.id+' • '+e.origin+(e.confidence?' • score '+e.confidence:'');box.append(meta);let state=document.createElement('p');state.className='status';state.textContent=e.decision??'Pending human review';box.append(state);for(const [name,act,cls] of [['View context',()=>jump(e),'secondary'],['Accept',()=>decide(e,'accepted'),''],['Reject',()=>decide(e,'rejected'),'reject']]){let b=document.createElement('button');b.textContent=name;b.className=cls;b.onclick=act;box.append(b)}$('events').append(box)}if(revealed)score();}
function score(){const m=computeMetrics(events);$('evaluation').hidden=false;$('evaluation').replaceChildren();let p=document.createElement('p');p.textContent='Planted events: 00:15 gate entry (suggested); 00:35 porch parcel movement (MISSED by fixture); 00:49 curtain movement (FALSE POSITIVE suggestion). Baseline fixture recall: 1/2 = 50%; precision: 1/2 = 50%. Ground truth is for evaluation only, never evidence.';$('evaluation').append(p);let metrics=document.createElement('div');metrics.className='metrics';for(const [label,value] of [['Accepted relevant events',m.truePositives],['Accepted false positives',m.falsePositives],['Relevant events still missing',m.falseNegatives],['Final recall',Math.round(m.recall*100)+'%'],['Session seconds',Math.round((Date.now()-start)/1000)]]){let d=document.createElement('div');d.className='metric';let b=document.createElement('strong');b.textContent=value;d.append(b,document.createTextNode(label));metrics.append(d)}$('evaluation').append(metrics)}
function reset(){events=INITIAL.map(e=>({...e,decision:null}));audit=[];t=0;playing=false;start=Date.now();revealed=false;$('evaluation').hidden=true;$('note').value='';$('feedback').textContent='';log('review-start');render();draw();}
function draw(){ctx.clearRect(0,0,720,400);ctx.fillStyle='#d8e5e3';ctx.fillRect(0,0,720,400);ctx.fillStyle='#8b9e86';ctx.fillRect(0,280,720,120);ctx.fillStyle='#f3e9d4';ctx.fillRect(220,65,380,230);ctx.fillStyle='#465966';ctx.fillRect(400,150,70,145);ctx.fillStyle='#91acbd';ctx.fillRect(260,115,90,80);ctx.fillStyle='#b9c7d2';ctx.fillRect(275+(t>47&&t<52?20:0),115,32,80);ctx.fillStyle='#a78258';ctx.fillRect(80,185,100,110);for(let x=90;x<180;x+=20)ctx.fillRect(x,160,8,140);ctx.fillStyle='#76858b';ctx.fillRect(350,295,180,105);if(t<35){ctx.fillStyle='#b78a55';ctx.fillRect(480,267,35,28)}if(t>=12&&t<=21){let x=70+(t-12)*27;ctx.fillStyle='#334951';ctx.beginPath();ctx.arc(x,210,12,0,Math.PI*2);ctx.fill();ctx.fillRect(x-10,222,20,45)}if(t>=32&&t<=40){let x=560-(t-32)*16;ctx.fillStyle='#5a4855';ctx.beginPath();ctx.arc(x,222,12,0,Math.PI*2);ctx.fill();ctx.fillRect(x-10,234,20,45);if(t>=35){ctx.fillStyle='#b78a55';ctx.fillRect(x-5,266,35,28)}}ctx.fillStyle='#142536';ctx.font='16px monospace';ctx.fillText('SYNTHETIC • SYN-CAM-01 • '+stamp(t),18,30);ctx.fillText('SIDE GATE',60,330);ctx.fillText('PORCH',430,330);$('seek').value=t;$('time').textContent=stamp(t)+' / 01:00';$('play').textContent=playing?'Pause source':'Play source';}
$('play').onclick=()=>{playing=!playing;log(playing?'play-source':'pause-source');draw()};$('seek').oninput=e=>{t=Number(e.target.value);playing=false;draw()};$('seek').onchange=()=>log('seek-source');$('reset').onclick=reset;
$('add').onclick=()=>{const label=$('note').value.trim();if(!label){$('feedback').textContent='Enter an observation before recording it.';return}const match=TRUTH.find(x=>Math.abs(x.time-t)<=3);const e={id:'HUM-'+(events.filter(x=>x.origin==='human-observation').length+1),time:Number(t.toFixed(1)),label,origin:'human-observation',truthId:match?.id??null,decision:'accepted'};events.push(e);log('human-observation-recorded',e);$('note').value='';$('feedback').textContent='Observation recorded with source timestamp. It can still be rejected.';render()};
$('reveal').onclick=()=>{revealed=true;log('ground-truth-revealed');score()};$('export').onclick=()=>{log('packet-export');const data=packet(events,audit,Math.round((Date.now()-start)/1000));if(!revealed)delete data.groundTruthMetrics;let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(data,null,2)],{type:'application/json'}));a.download='SYN-001-evidence-packet.json';a.click();URL.revokeObjectURL(a.href);$('feedback').textContent='Packet exported. Only accepted events included; all review actions retained.'};
function frame(now){if(playing&&last){t=Math.min(60,t+(now-last)/1000);if(t===60)playing=false;draw()}last=now;requestAnimationFrame(frame)}reset();requestAnimationFrame(frame);
}
